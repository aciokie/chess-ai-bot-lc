{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-undef": "off",
    "prefer-const": "error",
    "no-var": "error",
    "object-shorthand": "error",
    "prefer-arrow-callback": "error",
    "arrow-spacing": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js", "*.test.js", "*.spec.js"],
      "env": {
        "jest": true
      },
      "globals": {
        "test": "readonly",
        "expect": "readonly",
        "describe": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "vi": "readonly",
        "it": "readonly"
      }
    },
    {
      "files": ["chess-ai-bot.user.js", "src/**/*.js"],
      "rules": {
        "indent": "off",
        "no-undef": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/", "chess-ai-bot.user.js", "tests/performance.test.js"]
}